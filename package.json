{
  "name": "wavemark",
  "version": "0.1.0",
  "description": "Zero-dependency imperceptible audio watermarking for Bun",
  "license": "MIT",
  "bin": {
    "wavemark": "src/cli.ts"
  },
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun build ./src/cli.ts --compile --outfile wavemark",
    "lint": "oxlint .",
    "lint:fix": "bun lint --fix",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --disable-nested-config --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
