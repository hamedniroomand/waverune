{
  "name": "waverune",
  "version": "0.3.0",
  "description": "Zero-dependency blind audio watermarking for WAV files, with a measured support envelope. Runs on Node.js 22+ and Bun.",
  "keywords": [
    "audio",
    "dsp",
    "spread-spectrum",
    "steganography",
    "watermark",
    "wav"
  ],
  "homepage": "https://hamedniroomand.github.io/waverune/",
  "bugs": {
    "url": "https://github.com/hamedniroomand/waverune/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/waverune.git"
  },
  "bin": {
    "waverune": "dist/bin.js"
  },
  "workspaces": [
    "demo"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:binaries": "bun scripts/build-binaries.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "test:node": "node --test \"tests/node/*.smoke.mjs\"",
    "test:interop": "node tests/interop/run.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit && tsc --noEmit -p demo",
    "lint": "oxlint .",
    "lint:fix": "bun lint --fix",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --disable-nested-config --check",
    "bench:acceptance": "bun bench/acceptance.ts",
    "bench:crop": "bun bench/crop.ts",
    "bench:attacks": "bun bench/attacks.ts",
    "bench:resample": "bun bench/resample.ts",
    "bench:rejection": "bun bench/rejection.ts",
    "bench:masking": "bun bench/masking.ts",
    "bench:corpus": "bun bench/corpus.ts",
    "demo": "bun run --cwd demo dev",
    "demo:build": "bun run --cwd demo build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.20.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
