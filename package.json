{
  "name": "wavemark",
  "version": "0.2.0",
  "description": "Zero-dependency blind audio watermarking for WAV files on Bun, with a measured support envelope",
  "license": "MIT",
  "bin": {
    "wavemark": "src/cli.ts"
  },
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun build ./src/cli.ts --compile --outfile wavemark",
    "lint": "oxlint .",
    "lint:fix": "bun lint --fix",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --disable-nested-config --check",
    "bench:acceptance": "bun bench/acceptance.ts",
    "bench:crop": "bun bench/crop.ts",
    "bench:attacks": "bun bench/attacks.ts",
    "bench:resample": "bun bench/resample.ts",
    "bench:rejection": "bun bench/rejection.ts",
    "bench:masking": "bun bench/masking.ts",
    "bench:corpus": "bun bench/corpus.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
